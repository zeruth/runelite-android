.gradle
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
__pycache__/
*.pyc

# Android SDK location (machine-specific; auto-written by AGP)
local.properties

# Jagex launcher credentials — JX_* env-var values copied out of the desktop launcher
# and baked into runelite-mp's APK as an asset. Never commit.
credentials.properties
runelite-mp/src/androidMain/assets/credentials.properties

# Release signing keystores. Lost-this-file = lost-update-channel on Play Store,
# so back them up out-of-band — never commit. Passwords live in local.properties
# alongside sdk.dir; that file is already gitignored above.
*.jks
*.keystore
keystore/

### IntelliJ IDEA ###
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

### Eclipse ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

### VS Code ###
.vscode/

### Kotlin/Compose build state ###
.kotlin/

### Mac OS ###
.DS_Store

### client-inspector workspace ###
# Locally-built jars and decompiled sources from :client-inspector:sanitize/decompile/recompile.
data/
# ...but not 117 HD's rs117.hd.data source package.
!third-party/rlhd/src/main/java/rs117/hd/data/
# Local Vineflower fork used via includeBuild; patches live in its own git repo.
vineflower/
# javac argfile dumps written during ad-hoc debugging
client-inspector/javac.*.args
# CMake intermediates for the Android HD native bridge.
/android/.cxx/

# shaderc static libraries built from the NDK by :android:buildShaderc
android/.shaderc/

# OpenJDK reference checkouts (tools-src/fetch-jdk-reference.py); see third-party/JDK-REFERENCE.md
/third-party/jdk8u/
/third-party/jdk17u/

# Python bytecode caches the tools-src scripts leave beside themselves
__pycache__/
*.pyc

# Rhipper Agent roadmap and per-project state (local orchestration, not source)
/rhipper.md
/rhipper.context.md
/rhipper.toml
/var/
