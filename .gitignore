.gradle
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Android SDK location (machine-specific; auto-written by AGP)
local.properties

# Jagex launcher credentials — JX_* env-var values copied out of the desktop launcher
# and baked into runelite-mp's APK as an asset. Never commit.
credentials.properties
runelite-mp/src/androidMain/assets/credentials.properties

# Release signing keystores. Lost-this-file = lost-update-channel on Play Store,
# so back them up out-of-band — never commit. Passwords live in local.properties
# alongside sdk.dir; that file is already gitignored above.
*.jks
*.keystore
keystore/

### IntelliJ IDEA ###
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

### Eclipse ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

